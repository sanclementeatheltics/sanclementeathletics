<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>San Clemente Beach Varsity Athletics | Home of the Marlins</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700&family=Newsreader:ital,opsz,wght@0,6..72,500;1,6..72,400;1,6..72,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Yellowtail&display=swap" rel="stylesheet">
  <style>
    :root {
      --navy-dark: #07172b;
      --navy-main: #0b213d;
      --navy-light: #132e54;
      --cream: #fbf9f5;
      --cream-card: #ffffff;
      --red: #d81e28;
      --red-hover: #b8161f;
      --powder-blue: #7eb6ff;
      --powder-light: #d6e8ff;
      --text-dark: #10223b;
      --text-muted: #5b6d86;
      --border-light: #e6e2d8;
      --border-dark: rgba(255, 255, 255, 0.13);
      --font-display: 'Barlow Condensed', sans-serif;
      --font-serif: 'Newsreader', serif;
      --font-sans: 'Plus Jakarta Sans', sans-serif;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font-sans);
      background-color: var(--cream);
      color: var(--text-dark);
      overflow-x: hidden;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
    }
    .font-display { font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.025em; }
    .font-serif-italic { font-family: var(--font-serif); font-style: italic; }
    .marlin-swim-overlay { position: fixed; inset: 0; pointer-events: none; z-index: 9999; overflow: hidden; display: none; }
    .marlin-swim-overlay.active { display: block; }
    .marlin-swim-backdrop {
      position: absolute; inset: 0;
      background: radial-gradient(circle at center, rgba(126, 182, 255, 0.16) 0%, rgba(10, 28, 54, 0.38) 100%);
      opacity: 0; animation: marlinBackdropFade 1.25s ease-in-out forwards;
    }
    .marlin-swimmer-wrap {
      position: absolute; top: 50%; left: -620px; width: 580px; height: 360px; margin-top: -180px;
      filter: drop-shadow(0 18px 36px rgba(7, 22, 44, 0.55)) drop-shadow(0 0 28px rgba(126, 182, 255, 0.65));
      animation: marlinSwimAcross 1.25s cubic-bezier(0.22, 0.8, 0.32, 1) forwards;
    }
    .marlin-swimmer-wrap svg { width: 100%; height: 100%; overflow: visible; }
    @keyframes marlinSwimAcross {
      0% { transform: translateX(0) translateY(24px) rotate(4deg) scale(0.82); opacity: 0; }
      15% { opacity: 1; }
      35% { transform: translateX(42vw) translateY(-18px) rotate(-4deg) scale(1.04); }
      65% { transform: translateX(85vw) translateY(12px) rotate(3deg) scale(1.06); opacity: 1; }
      100% { transform: translateX(calc(100vw + 740px)) translateY(-22px) rotate(-5deg) scale(0.95); opacity: 0; }
    }
    @keyframes marlinBackdropFade {
      0% { opacity: 0; } 25% { opacity: 1; } 75% { opacity: 1; } 100% { opacity: 0; }
    }
    header {
      position: sticky; top: 0; z-index: 1000;
      background-color: var(--navy-dark);
      border-bottom: 1px solid var(--border-dark);
      color: #fff;
    }
    .nav-container {
      max-width: 1360px; margin: 0 auto; height: 76px;
      display: flex; align-items: center; justify-content: space-between; padding: 0 32px;
    }
    .brand { display: flex; align-items: center; gap: 14px; cursor: pointer; text-decoration: none; color: #fff; }
    .brand-badge {
      background-color: var(--red); color: #fff; font-family: var(--font-display);
      font-weight: 700; font-size: 18px; width: 40px; height: 40px; border-radius: 4px;
      display: flex; align-items: center; justify-content: center; letter-spacing: 0.05em;
    }
    .brand-text h1 { font-family: var(--font-display); font-weight: 700; font-size: 19px; letter-spacing: 0.06em; line-height: 1.05; }
    .brand-text span { font-family: var(--font-serif); font-style: italic; font-size: 13.5px; color: var(--powder-blue); display: block; }
    .nav-links { display: flex; align-items: center; gap: 32px; }
    .nav-btn {
      background: none; border: none; color: rgba(255, 255, 255, 0.88);
      font-family: var(--font-sans); font-size: 12px; font-weight: 600;
      letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer;
      display: flex; align-items: center; gap: 6px; padding: 8px 0; transition: color 0.2s;
    }
    .nav-btn:hover, .nav-btn.active { color: var(--powder-blue); }
    .nav-caret-svg { width: 12px; height: 12px; transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
    .nav-btn.active .nav-caret-svg { transform: rotate(180deg); }
    .mega-menu {
      position: absolute; top: 76px; left: 0; width: 100%;
      background-color: var(--navy-main); border-bottom: 2px solid var(--red);
      box-shadow: 0 24px 48px rgba(0, 0, 0, 0.45); padding: 36px 32px 24px; z-index: 999;
      opacity: 0; visibility: hidden; transform: translateY(-12px);
      transition: opacity 0.32s cubic-bezier(0.22, 1, 0.36, 1), transform 0.32s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.32s;
      pointer-events: none;
    }
    .mega-menu.open { opacity: 1; visibility: visible; transform: translateY(0); pointer-events: auto; }
    .mega-inner { max-width: 1360px; margin: 0 auto; }
    .mega-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; padding-bottom: 28px; border-bottom: 1px solid var(--border-dark); }
    .mega-season-header { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 10px; margin-bottom: 16px; border-bottom: 1px solid var(--border-dark); }
    .mega-season-header h3 { font-family: var(--font-display); font-size: 22px; font-weight: 700; letter-spacing: 0.06em; color: #fff; }
    .mega-season-header span { font-size: 11px; letter-spacing: 0.12em; color: rgba(255, 255, 255, 0.5); text-transform: uppercase; }
    .mega-sub-group { margin-bottom: 18px; }
    .mega-sub-title { font-size: 10px; font-weight: 700; letter-spacing: 0.15em; color: rgba(255, 255, 255, 0.5); text-transform: uppercase; margin-bottom: 6px; }
    .mega-sport-list { list-style: none; }
    .mega-sport-item { padding: 2px 0; }
    .mega-sport-link {
      color: rgba(255, 255, 255, 0.85); text-decoration: none; font-size: 14px; font-weight: 500;
      cursor: pointer; transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
      display: inline-block; padding: 3px 8px; margin-left: -8px; border-radius: 4px; border-left: 2px solid transparent;
    }
    .mega-sport-link.womens-link:hover { color: var(--powder-blue); background: rgba(126, 182, 255, 0.14); border-left-color: var(--powder-blue); transform: translateX(6px); }
    .mega-sport-link.mens-link:hover { color: #ff6b72; background: rgba(216, 30, 40, 0.18); border-left-color: var(--red); transform: translateX(6px); }
    .mega-sport-link.coed-link:hover { color: var(--powder-blue); background: linear-gradient(90deg, rgba(216, 30, 40, 0.18), rgba(126, 182, 255, 0.16)); border-left-color: var(--red); transform: translateX(6px); }
    .mega-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 18px; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255, 255, 255, 0.5); }
    .mega-footer a { color: #fff; text-decoration: none; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
    .mega-footer a:hover { color: var(--powder-blue); }
    .hero { background-color: var(--navy-main); color: #fff; position: relative; overflow: hidden; padding: 84px 32px 64px; border-bottom: 1px solid var(--border-dark); }
    .hero-watermark { position: absolute; right: -20px; top: 10px; font-family: var(--font-display); font-size: 280px; font-weight: 800; line-height: 0.85; color: rgba(255, 255, 255, 0.03); pointer-events: none; user-select: none; text-transform: uppercase; }
    .hero-inner { max-width: 1360px; margin: 0 auto; position: relative; z-index: 2; }
    .eyebrow { display: flex; align-items: center; gap: 12px; font-size: 11.5px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255, 255, 255, 0.72); margin-bottom: 18px; }
    .eyebrow::before { content: ""; width: 28px; height: 2px; background-color: var(--red); }
    .hero-title { font-family: var(--font-display); font-weight: 800; font-size: clamp(58px, 8.5vw, 114px); line-height: 0.92; letter-spacing: 0.015em; text-transform: uppercase; margin-bottom: 18px; }
    .hero-title .powder-line { color: var(--powder-blue); display: block; }
    .marlins-lockup { display: inline-flex; align-items: baseline; gap: 14px; margin-bottom: 24px; }
    .home-of-the { font-family: var(--font-display); font-size: 18px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255, 255, 255, 0.92); }
    .retro-marlins-text { font-family: 'Yellowtail', cursive; font-size: clamp(46px, 5.6vw, 68px); color: var(--red); line-height: 1; letter-spacing: 0.02em; text-shadow: 2px 3px 0px #040d1a; display: inline-block; transform: rotate(-2deg); }
    .hero-desc { max-width: 590px; color: rgba(255, 255, 255, 0.8); font-size: 16.5px; line-height: 1.65; margin-bottom: 36px; }
    .hero-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 32px; padding-top: 24px; }
    .btn-group { display: flex; gap: 16px; flex-wrap: wrap; }
    .btn-primary { background-color: var(--red); color: #fff; border: none; border-radius: 3px; padding: 15px 26px; font-family: var(--font-sans); font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 10px; transition: background 0.2s, transform 0.15s; }
    .btn-primary:hover { background-color: var(--red-hover); transform: translateY(-2px); }
    .btn-outline { background: transparent; color: #fff; border: 1px solid rgba(255, 255, 255, 0.35); border-radius: 3px; padding: 15px 26px; font-family: var(--font-sans); font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 10px; transition: border-color 0.2s, color 0.2s; }
    .btn-outline:hover { border-color: var(--powder-blue); color: var(--powder-blue); }
    .hero-stats { display: flex; gap: 48px; border-top: 1px solid var(--border-dark); padding-top: 20px; }
    .stat-item h4 { font-family: var(--font-display); font-weight: 700; font-size: 42px; line-height: 1; margin-bottom: 4px; }
    .stat-item p { font-size: 10.5px; font-weight: 600; letter-spacing: 0.14em; color: rgba(255, 255, 255, 0.58); text-transform: uppercase; }
    .section-light { max-width: 1360px; margin: 0 auto; padding: 88px 32px; }
    .program-grid { display: grid; grid-template-columns: 1fr 1.25fr; gap: 64px; align-items: start; }
    .section-kicker { font-family: var(--font-serif); font-style: italic; color: var(--red); font-size: 21px; margin-bottom: 6px; }
    .section-heading { font-family: var(--font-display); font-weight: 800; font-size: clamp(38px, 4.8vw, 58px); line-height: 0.96; letter-spacing: 0.02em; text-transform: uppercase; color: var(--text-dark); margin-bottom: 24px; }
    .program-stats-grid { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--border-light); margin-top: 36px; }
    .p-stat { padding: 24px 16px 24px 0; border-bottom: 1px solid var(--border-light); }
    .p-stat:nth-child(odd) { border-right: 1px solid var(--border-light); }
    .p-stat:nth-child(even) { padding-left: 24px; }
    .p-stat .num { font-family: var(--font-display); font-weight: 700; font-size: 38px; color: var(--red); line-height: 1; margin-bottom: 4px; }
    .p-stat .lbl { font-size: 11px; font-weight: 600; letter-spacing: 0.13em; color: var(--text-muted); text-transform: uppercase; }
    .program-copy p { font-size: 17px; color: #273852; line-height: 1.75; margin-bottom: 22px; }
    .section-divider-block { background-color: var(--navy-main); color: #fff; padding: 48px 32px; margin: 64px -32px 72px -32px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px; border-left: 6px solid var(--red); border-right: 6px solid var(--powder-blue); box-shadow: 0 12px 32px rgba(7, 22, 44, 0.18); }
    .divider-block-content h3 { font-family: var(--font-display); font-size: 32px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 4px; }
    .divider-block-content p { font-size: 15px; color: rgba(255, 255, 255, 0.78); }
    .divider-pill { background: rgba(126, 182, 255, 0.15); border: 1px solid var(--powder-blue); color: var(--powder-blue); padding: 10px 22px; font-family: var(--font-display); font-size: 14px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
    .seasons-section { padding-top: 0; }
    .accordion-item { border-top: 1px solid var(--text-dark); padding: 24px 0; }
    .accordion-item:last-child { border-bottom: 1px solid var(--text-dark); }
    .accordion-header { display: flex; justify-content: space-between; align-items: center; cursor: pointer; user-select: none; padding: 6px 0; transition: opacity 0.2s; }
    .accordion-header:hover { opacity: 0.85; }
    .accordion-title-group { display: flex; align-items: baseline; gap: 20px; }
    .accordion-title-group h3 { font-family: var(--font-display); font-weight: 700; font-size: 40px; letter-spacing: 0.03em; }
    .accordion-title-group span { font-size: 12px; font-weight: 600; letter-spacing: 0.14em; color: var(--text-muted); text-transform: uppercase; }
    .accordion-meta { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; color: var(--red); text-transform: uppercase; display: flex; align-items: center; gap: 8px; }
    .accordion-caret { display: inline-flex; align-items: center; transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1); }
    .accordion-item.open .accordion-caret { transform: rotate(180deg); }
    .accordion-collapse { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows 0.42s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.35s ease, padding-top 0.35s ease; padding-top: 0; }
    .accordion-item.open .accordion-collapse { grid-template-rows: 1fr; opacity: 1; padding-top: 28px; }
    .accordion-body-inner { overflow: hidden; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px; }
    .squad-col-header { font-size: 11px; font-weight: 700; letter-spacing: 0.15em; color: var(--text-muted); text-transform: uppercase; padding-bottom: 10px; border-bottom: 2px solid var(--border-light); margin-bottom: 8px; }
    .squad-col-header.womens-header { border-bottom-color: var(--powder-blue); }
    .squad-col-header.mens-header { border-bottom-color: var(--red); }
    .squad-row { display: flex; justify-content: space-between; align-items: center; padding: 16px 12px; border-bottom: 1px solid var(--border-light); border-left: 4px solid transparent; border-radius: 0 4px 4px 0; cursor: pointer; transition: all 0.24s cubic-bezier(0.22, 1, 0.36, 1); }
    .squad-row.womens-sport:hover { background-color: rgba(126, 182, 255, 0.22); border-left-color: var(--powder-blue); padding-left: 20px; }
    .squad-row.womens-sport:hover h4, .squad-row.womens-sport:hover .squad-arrow { color: #1456a8; }
    .squad-row.mens-sport:hover { background-color: rgba(216, 30, 40, 0.11); border-left-color: var(--red); padding-left: 20px; }
    .squad-row.mens-sport:hover h4, .squad-row.mens-sport:hover .squad-arrow { color: var(--red); }
    .squad-row.coed-sport:hover { background: linear-gradient(90deg, rgba(216, 30, 40, 0.1), rgba(126, 182, 255, 0.22)); border-left-color: var(--red); padding-left: 20px; }
    .squad-row.coed-sport:hover h4, .squad-row.coed-sport:hover .squad-arrow { color: var(--red); }
    .squad-row h4 { font-family: var(--font-display); font-weight: 700; font-size: 20px; letter-spacing: 0.03em; margin-bottom: 2px; transition: color 0.2s; }
    .squad-row p { font-size: 11px; font-weight: 500; letter-spacing: 0.08em; color: var(--text-muted); text-transform: uppercase; }
    .squad-arrow { color: var(--text-muted); display: inline-flex; align-items: center; justify-content: center; transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1), color 0.2s; }
    .squad-row:hover .squad-arrow { transform: translate(3px, -3px); }
    .captains-section { background-color: var(--navy-main); color: #fff; padding: 108px 32px 96px; position: relative; overflow: visible; }
    .captains-banner-watermark { position: absolute; left: -10px; top: 18px; font-family: var(--font-display); font-size: 240px; font-weight: 800; line-height: 0.85; color: rgba(255, 255, 255, 0.025); pointer-events: none; user-select: none; text-transform: uppercase; }
    .captains-inner { max-width: 1360px; margin: 0 auto; position: relative; z-index: 2; }
    .captains-banner-header { display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: end; padding-bottom: 42px; margin-bottom: 42px; border-bottom: 1px solid var(--border-dark); }
    .captains-banner-title { font-family: var(--font-display); font-weight: 800; font-size: clamp(52px, 6.5vw, 86px); line-height: 0.92; letter-spacing: 0.015em; text-transform: uppercase; color: #fff; margin-bottom: 20px; }
    .captains-sub { color: rgba(255, 255, 255, 0.8); max-width: 560px; font-size: 17px; line-height: 1.65; }
    .captains-code-panel { background: rgba(19, 46, 84, 0.72); border: 1px solid rgba(126, 182, 255, 0.25); border-left: 4px solid var(--red); border-radius: 4px; padding: 32px 36px; color: #fff; box-shadow: 0 20px 44px rgba(0, 0, 0, 0.25); }
    .code-header-row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18px; padding-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
    .code-title { font-family: var(--font-display); font-weight: 700; font-size: 24px; letter-spacing: 0.08em; text-transform: uppercase; color: #fff; }
    .code-subtitle { font-family: var(--font-serif); font-style: italic; font-size: 15px; color: var(--powder-blue); }
    .code-pillars { list-style: none; display: grid; gap: 12px; }
    .code-pillars li { display: grid; grid-template-columns: 28px 1fr; align-items: baseline; font-size: 14.5px; line-height: 1.55; color: rgba(255, 255, 255, 0.92); }
    .code-num { font-family: var(--font-display); font-size: 16px; font-weight: 700; color: var(--red); letter-spacing: 0.06em; }
    .code-pillars strong { color: #fff; font-weight: 600; }
    .captain-search-wrapper { margin-bottom: 40px; position: relative; max-width: 520px; }
    .captain-search-input { width: 100%; background: rgba(19, 46, 84, 0.92); border: 1px solid rgba(126, 182, 255, 0.35); border-radius: 4px; padding: 16px 20px 16px 48px; font-family: var(--font-sans); font-size: 15px; color: #fff; outline: none; transition: border-color 0.2s, box-shadow 0.2s; }
    .captain-search-input::placeholder { color: rgba(255, 255, 255, 0.5); }
    .captain-search-input:focus { border-color: var(--powder-blue); box-shadow: 0 0 0 3px rgba(126, 182, 255, 0.25); }
    .captain-search-icon { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--powder-blue); pointer-events: none; display: inline-flex; }
    .search-suggestions-dropdown { position: absolute; top: calc(100% + 6px); left: 0; width: 100%; background: var(--navy-dark); border: 1px solid var(--powder-blue); border-radius: 4px; box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5); z-index: 99; max-height: 260px; overflow-y: auto; display: none; }
    .search-suggestions-dropdown.open { display: block; }
    .suggestion-item { padding: 12px 18px; font-size: 14px; color: rgba(255, 255, 255, 0.9); cursor: pointer; border-bottom: 1px solid rgba(255, 255, 255, 0.08); display: flex; justify-content: space-between; align-items: center; transition: background 0.15s, color 0.15s; }
    .suggestion-item:last-child { border-bottom: none; }
    .suggestion-item:hover { background: rgba(126, 182, 255, 0.2); color: var(--powder-blue); }
    .suggestion-item span.match-tag { font-size: 10.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; background: rgba(216, 30, 40, 0.3); color: #ff9b9f; padding: 2px 8px; border-radius: 2px; }
    .captains-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(235px, 1fr)); gap: 24px; }
    .captain-card { background-color: var(--navy-light); border: 2px solid rgba(255, 255, 255, 0.1); border-radius: 4px; display: flex; flex-direction: column; position: relative; overflow: hidden; transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.35s ease, box-shadow 0.35s ease; }
    .captain-card:hover { transform: translateY(-6px) scale(1.02); border-color: var(--powder-blue); box-shadow: 0 0 0 2px var(--red), 0 14px 32px -4px rgba(216, 30, 40, 0.55), 0 0 28px 4px rgba(126, 182, 255, 0.7); z-index: 5; }
    .portrait-box { position: relative; width: 100%; aspect-ratio: 4 / 4.3; background-color: #d8dde6; overflow: hidden; cursor: pointer; }
    .portrait-box img, .portrait-box svg.rendered-portrait { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), filter 0.35s ease; }
    .portrait-box:hover img, .portrait-box:hover svg.rendered-portrait, .captain-card:hover .portrait-box img, .captain-card:hover .portrait-box svg.rendered-portrait { transform: scale(1.09); filter: contrast(1.05) saturate(1.08); }
