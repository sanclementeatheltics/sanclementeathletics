  function submitBuilderCommitment() {
    const athleteSelect = document.getElementById('builder-athlete-select');
    const schoolInput = document.getElementById('builder-school-input');
    const expInput = document.getElementById('builder-explanation-input');
    if (!athleteSelect || !schoolInput || !schoolInput.value.trim()) return;

    const [athleteName, sportId, grade, isCapStr] = athleteSelect.value.split('|');
    const sp = SPORTS_DATA.find(s => s.id === sportId) || SPORTS_DATA[0];
    const sObj = beyondSeaState.selectedSchoolObj || getSchoolObject(schoolInput.value.trim());

    const autoExplanation = expInput.value.trim() ||
      `${athleteName.split(' ')[0]} connected immediately with the coaching staff and campus community at ${sObj.name}, choosing to continue both their academic studies and ${sp.shortSport.toLowerCase()} career as one of the ${sObj.mascot}.`;

    saveCustomCommit(athleteName, {
      school: sObj.name,
      division: sObj.division,
      grade: grade,
      gradClass: grade === 'Jr.' ? 'Class of 2028' : 'Class of 2027',
      sportId: sportId,
      isCaptain: isCapStr === 'true',
      explanation: autoExplanation
    });

    beyondSeaState.builderOpen = false;
    renderCurrentState();
  }

