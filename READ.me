  async function syncAllNCAASchoolsFromAPI() {
    const endpoints = [
      { url: "https://site.api.espn.com/apis/site/v2/sports/basketball/mens-college-basketball/teams?limit=1000", defaultDiv: "D1" },
      { url: "https://site.api.espn.com/apis/site/v2/sports/football/college-football/teams?limit=1000", defaultDiv: "D2/D3" },
      { url: "https://site.api.espn.com/apis/site/v2/sports/baseball/college-baseball/teams?limit=1000", defaultDiv: "D1" }
    ];
    const existingNames = new Set(NCAA_MASTER_DB.map(s => s.name.toLowerCase()));

    for (const ep of endpoints) {
      try {
        const res = await fetch(ep.url);
        if (!res.ok) continue;
        const data = await res.json();
        const teams = (data?.sports?.[0]?.leagues?.[0]?.teams) || [];
        teams.forEach(entry => {
          const t = entry.team;
          if (!t || !t.location) return;
          const schoolName = t.location.trim();
          if (existingNames.has(schoolName.toLowerCase())) return;
          existingNames.add(schoolName.toLowerCase());

          const logo = (t.logos && t.logos[0] && t.logos[0].href)
            ? t.logos[0].href
            : `https://a.espncdn.com/i/teamlogos/ncaa/500/${t.id}.png`;
          const slug = schoolName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
          let div = ep.defaultDiv === "D1" ? "D1" : (Number(t.id) > 2000 ? "D3" : "D2");

          NCAA_MASTER_DB.push({
            name: schoolName,
            division: div,
            state: "US",
            mascot: t.name || "Varsity",
            color: t.color ? `#${t.color}` : "#0b213d",
            espnId: String(t.id),
            ncaaSlug: slug,
            domain: `${slug.replace(/-/g, '')}.edu`,
            logoUrl: logo
          });
        });
      } catch (err) {}
    }
    const countEl = document.getElementById('ncaa-db-total-badge');
    if (countEl) countEl.textContent = `${NCAA_MASTER_DB.length.toLocaleString()} NCAA D1–D3 SCHOOLS AVAILABLE`;
  }
  function formatSchoolCommitStatement(schoolName) {
    const clean = String(schoolName).trim();
    // If the university name already starts with "the" or proper pronouns, return as-is
    if (/^the\s+/i.test(clean)) {
      return clean;
    }
    // Add "the" if it starts with "University of" or "College of"
    if (/^university of/i.test(clean) || /^college of/i.test(clean)) {
      return `the ${clean}`;
    }
    // Otherwise return clean name (e.g., "Stanford University", "UCLA", "USC")
    return clean;
  }

  function createFallbackCrestDataURI(schoolName, color = "#0b213d") {
    const words = String(schoolName).replace(/University|of|College|State|the/gi, '').trim().split(/\s+/);
    const initials = ((words[0] ? words[0][0] : 'U') + (words[1] ? words[1][0] : '')).toUpperCase();
    const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120">
      <path d="M16 14 H104 V62 C104 92 60 110 60 110 C60 110 16 92 16 62 Z" fill="${color}" stroke="#07172b" stroke-width="5"/>
      <text x="60" y="69" text-anchor="middle" font-family="Impact, Arial Black, sans-serif" font-size="38" fill="#ffffff" letter-spacing="2">${initials}</text>
    </svg>`;
    return `data:image/svg+xml;utf8,` + encodeURIComponent(svg);
  }

  function handleCollegeLogoError(imgEl) {
    const step = Number(imgEl.dataset.fallbackStep || "0");
    const slug = imgEl.dataset.slug || "";
    const espnId = imgEl.dataset.espnId || "";
    const schoolName = imgEl.dataset.school || "University";
    const color = imgEl.dataset.color || "#0b213d";

    if (step === 0 && slug) {
      imgEl.dataset.fallbackStep = "1";
      imgEl.src = `https://i.turner.ncaa.com/sites/default/files/images/logos/schools/bgd/${slug}.svg`;
    } else if (step <= 1 && espnId) {
      imgEl.dataset.fallbackStep = "2";
      imgEl.src = `https://a.espncdn.com/i/teamlogos/ncaa/500/${espnId}.png`;
    } else {
      imgEl.onerror = null;
      imgEl.src = createFallbackCrestDataURI(schoolName, color);
    }
  }

  function getSchoolObject(schoolName) {
    const found = NCAA_MASTER_DB.find(s => s.name.toLowerCase() === schoolName.toLowerCase());
    if (found) return found;
    const slug = schoolName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    return {
      name: schoolName,
      division: "D1",
      state: "US",
      mascot: "Varsity",
      color: "#0b213d",
      espnId: "",
      ncaaSlug: slug,
      domain: "",
      logoUrl: `https://i.turner.ncaa.com/sites/default/files/images/logos/schools/bgd/${slug}.svg`
    };
  }

  function renderUniversityLogoImg(schoolObj, altText = "") {
    const s = typeof schoolObj === "string" ? getSchoolObject(schoolObj) : schoolObj;
    return `<img
      src="${s.logoUrl}"
      alt="${escapeHTML(altText || s.name)} Logo"
      style="width:100%; height:100%; max-width:100%; max-height:100%; object-fit:contain; display:block;"
      data-slug="${escapeHTML(s.ncaaSlug || '')}"
      data-espn-id="${escapeHTML(s.espnId || '')}"
      data-school="${escapeHTML(s.name)}"
      data-color="${escapeHTML(s.color || '#0b213d')}"
      onerror="handleCollegeLogoError(this)"
    />`;
  }

