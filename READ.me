              <h6>${match.rival.name} METRICS</h6>
              <div class="hub-stat-row"><span>Winners:</span><strong>${s.oppWinners}</strong></div>
              <div class="hub-stat-row"><span>Unforced Errors:</span><strong>${s.oppErrors}</strong></div>
            </div>
          </div>
        `;
      }
      if (s.type === 'diamond') {
        return `
          <div class="hub-stat-grid">
            <div class="hub-stat-box">
              <h6>SCB TEAM TOTALS</h6>
              <div class="hub-stat-row"><span>Hits:</span><strong>${s.scbHits}</strong></div>
              <div class="hub-stat-row"><span>Errors:</span><strong>${s.scbErrors}</strong></div>
            </div>
            <div class="hub-stat-box">
              <h6>${match.rival.name} TOTALS</h6>
              <div class="hub-stat-row"><span>Hits:</span><strong>${s.oppHits}</strong></div>
              <div class="hub-stat-row"><span>Errors:</span><strong>${s.oppErrors}</strong></div>
            </div>
          </div>
        `;
      }
      if (s.type === 'wrestling') {
        return `
          <div class="hub-stat-grid">
            <div class="hub-stat-box">
              <h6>SCB TEAM METRICS</h6>
              <div class="hub-stat-row"><span>Pins/Falls:</span><strong>${s.scbPins}</strong></div>
              <div class="hub-stat-row"><span>Takedowns:</span><strong>${s.scbTD}</strong></div>
            </div>
            <div class="hub-stat-box">
              <h6>${match.rival.name} METRICS</h6>
              <div class="hub-stat-row"><span>Pins/Falls:</span><strong>${s.oppPins}</strong></div>
              <div class="hub-stat-row"><span>Takedowns:</span><strong>${s.oppTD}</strong></div>
            </div>
          </div>
        `;
      }
      if (s.type === 'golf') {
        return `
          <div class="hub-stat-grid">
            <div class="hub-stat-box">
              <h6>SCB SQUAD (CUMULATIVE STROKES)</h6>
              <div class="hub-stat-row"><span>Birdies:</span><strong>${s.scbBirdies}</strong></div>
              <div class="hub-stat-row"><span>Pars:</span><strong>${s.scbPars}</strong></div>
            </div>
            <div class="hub-stat-box">
              <h6>${match.rival.name} SQUAD</h6>
              <div class="hub-stat-row"><span>Birdies:</span><strong>${s.oppBirdies}</strong></div>
              <div class="hub-stat-row"><span>Pars:</span><strong>${s.oppPars}</strong></div>
            </div>
          </div>
        `;
      }
      if (s.type === 'meet') {
        return `
          <div class="hub-stat-grid">
            <div class="hub-stat-box">
              <h6>SCB TEAM METRICS</h6>
              <div class="hub-stat-row"><span>Events Won:</span><strong>${s.scbEventsWon}</strong></div>
            </div>
            <div class="hub-stat-box">
              <h6>${match.rival.name} METRICS</h6>
              <div class="hub-stat-row"><span>Events Won:</span><strong>${s.oppEventsWon}</strong></div>
            </div>
          </div>
        `;
      }
      if (s.type === 'volleyball') {
        return `
          <div class="hub-stat-grid">
            <div class="hub-stat-box">
              <h6>SCB TEAM TOTALS</h6>
              <div class="hub-stat-row"><span>Kills:</span><strong>${s.scbKills}</strong></div>
              <div class="hub-stat-row"><span>Digs:</span><strong>${s.scbDigs}</strong></div>
              <div class="hub-stat-row"><span>Blocks:</span><strong>${s.scbBlocks}</strong></div>
            </div>
            <div class="hub-stat-box">
              <h6>${match.rival.name} TOTALS</h6>
              <div class="hub-stat-row"><span>Kills:</span><strong>${s.oppKills}</strong></div>
              <div class="hub-stat-row"><span>Digs:</span><strong>${s.oppDigs}</strong></div>
              <div class="hub-stat-row"><span>Blocks:</span><strong>${s.oppBlocks}</strong></div>
            </div>
          </div>
        `;
      }
      if (s.type === 'football') {
        return `
          <div class="hub-stat-grid">
            <div class="hub-stat-box">
              <h6>SCB OFFENSE / DEFENSE</h6>
              <div class="hub-stat-row"><span>Total Yards:</span><strong>${s.scbYards}</strong></div>
              <div class="hub-stat-row"><span>1st Downs:</span><strong>${s.scb1stDowns}</strong></div>
            </div>
            <div class="hub-stat-box">
              <h6>${match.rival.name} OFFENSE / DEFENSE</h6>
