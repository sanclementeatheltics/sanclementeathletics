  let beyondSeaState = {
    activeGradeTab: 'ALL',
    activeDivFilter: 'ALL',
    searchQuery: '',
    builderOpen: false,
    selectedSchoolObj: null
  };

  function openBeyondTheSeaPage() {
    closeMegaMenu();
    playMarlinSwimAnimation();
    appState.view = 'commits';
    renderCurrentState();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function setBeyondGradeTab(gradeKey) {
    beyondSeaState.activeGradeTab = gradeKey;
    renderCurrentState();
  }

  function setBeyondDivFilter(divKey) {
    beyondSeaState.activeDivFilter = divKey;
    renderCurrentState();
  }

  function handleBeyondSearch(val) {
    beyondSeaState.searchQuery = val;
    const grid = document.getElementById('commits-wall-grid-container');
    if (grid) grid.innerHTML = renderCommitsCardsGridHTML();
  }

  function toggleCommitBuilder() {
    beyondSeaState.builderOpen = !beyondSeaState.builderOpen;
    renderCurrentState();
  }

  function getAllHydratedCommits() {
    const db = getCommitsDatabase();
    const list = [];

    Object.keys(db).forEach(athleteKey => {
      const entry = db[athleteKey];
      const sp = SPORTS_DATA.find(s => s.id === entry.sportId) || SPORTS_DATA[0];
      const schoolObj = getSchoolObject(entry.school);
      const effectiveDiv = entry.division || schoolObj.division || "D1";

      let position = sp.captain && sp.captain.name.includes(athleteKey.replace(/ (Sr\.|Jr\.)$/, ''))
        ? (sp.captain.position || sp.shortSport)
        : sp.shortSport;

      const rosterArr = TEAM_ROSTERS[sp.id] || [];
      const cleanKey = athleteKey.replace(/\s+(Sr\.|Jr\.|So\.|Fr\.)$/i, '').trim().toLowerCase();
      let rosterIndex = rosterArr.findIndex(r => {
        const rClean = String(r[0]).replace(/\s+(Sr\.|Jr\.|So\.|Fr\.)$/i, '').trim().toLowerCase();
        return r[0].toLowerCase() === athleteKey.toLowerCase() || rClean === cleanKey;
      });
      if (rosterIndex >= 0 && rosterArr[rosterIndex][4]) {
        position = rosterArr[rosterIndex][4];
      }

      list.push({
        athleteName: athleteKey,
        grade: entry.grade || "Sr.",
        gradClass: entry.gradClass || (entry.grade === "Jr." ? "Class of 2028" : "Class of 2027"),
        sport: sp,
        position: position,
        isCaptain: Boolean(entry.isCaptain),
        rosterIndex: rosterIndex,
        schoolObj: { ...schoolObj, division: effectiveDiv },
        explanation: entry.explanation
      });
    });

    return list;
  }

  // Bulletproof click handler for Commit Cards (stops document click listener from closing modal)
  function handleCommitCardClick(event, sportId, isCaptain, rosterIndex, athleteName) {
    if (event) {
      event.preventDefault();
      event.stopPropagation();
    }
    if (isCaptain) {
      openCaptainPage(sportId);
      return;
    }
    // Resolve roster index by index or name fallback
    let idx = Number(rosterIndex);
    const roster = TEAM_ROSTERS[sportId] || [];
    if (idx < 0 || !roster[idx]) {
      const cleanTarget = String(athleteName).replace(/\s+(Sr\.|Jr\.|So\.|Fr\.)$/i, '').trim().toLowerCase();
      idx = roster.findIndex(r => String(r[0]).replace(/\s+(Sr\.|Jr\.|So\.|Fr\.)$/i, '').trim().toLowerCase() === cleanTarget);
    }
    if (idx >= 0) {
      setTimeout(() => showRosterAthleteModal(sportId, idx), 10);
    } else {
      openSportPage(sportId);
    }
  }

  function renderCommitsCardsGridHTML() {
    const allCommits = getAllHydratedCommits();
    const q = beyondSeaState.searchQuery.toLowerCase().trim();

    const filtered = allCommits.filter(item => {
      if (beyondSeaState.activeGradeTab !== 'ALL' && item.grade !== beyondSeaState.activeGradeTab) return false;
      if (beyondSeaState.activeDivFilter !== 'ALL' && item.schoolObj.division !== beyondSeaState.activeDivFilter) return false;
      if (q) {
        const hay = `${item.athleteName} ${item.schoolObj.name} ${item.schoolObj.mascot} ${item.sport.name} ${item.position} ${item.schoolObj.division}`.toLowerCase();
        if (!hay.includes(q)) return false;
      }
      return true;
    });

    if (filtered.length === 0) {
