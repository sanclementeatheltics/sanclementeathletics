    function renderHubCards() {
      const target = document.getElementById('hub-cards-target');
      if (!target) return;

      if (hubActiveTab === 'upcoming') {
        if (seasonalGamesDatabase.upcoming.length === 0) {
          target.innerHTML = `<div style="padding:48px; text-align:center; color:rgba(255,255,255,0.5); font-weight:600; letter-spacing:0.1em;">NO UPCOMING SCHEDULES TO DISPLAY.</div>`;
          return;
        }
        target.innerHTML = `<div class="hub-grid">` + seasonalGamesDatabase.upcoming.map(item => {
          const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(item.venue.address)}`;
          return `
            <div class="hub-match-card">
              <div class="hub-match-top">
                <span>${item.sport.name.toUpperCase()} · ${item.sport.squad}</span>
                <span class="hub-match-badge scheduled">${item.dateStr} · ${item.timeStr}</span>
              </div>
              <div class="hub-match-content">
                <div class="hub-scoreboard">
                  <div class="hub-team-block"><div class="hub-team-title">MARLINS</div></div>
                  <div class="hub-score-display" style="font-size:16px; color:rgba(255,255,255,0.4);">VS</div>
                  <div class="hub-team-block away"><div class="hub-team-title">${item.rival.name.toUpperCase()}</div></div>
                </div>
                <div class="hub-location-row">
                  <span style="color:rgba(255,255,255,0.6);">${item.isHome ? 'Home Game' : 'Away Game'}</span>
                  <a href="${mapsUrl}" target="_blank" class="hub-map-link">📍 ${item.venue.name}</a>
                </div>
              </div>
            </div>
          `;
        }).join('') + `</div>`;
        return;
      }

      const matchList = hubActiveTab === 'live' ? seasonalGamesDatabase.live : seasonalGamesDatabase.final;

      if (matchList.length === 0) {
        const msg = hubActiveTab === 'live' 
          ? "NO LIVE GAMES CURRENTLY IN PROGRESS.<br/><span style='font-size:12px; color:var(--powder-blue); display:block; margin-top:8px;'>CHECK THE UPCOMING SCHEDULE TAB.</span>" 
          : "NO RECENT RESULTS FILED YET.";
        target.innerHTML = `<div style="padding:48px; text-align:center; color:rgba(255,255,255,0.5); font-weight:600; letter-spacing:0.1em; line-height:1.6;">${msg}</div>`;
        return;
      }

      target.innerHTML = `<div class="hub-grid">` + matchList.map(match => {
        const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(match.venue.address)}`;
        const isLive = !match.isFinal && hubActiveTab === 'live';
        const displayClock = formatClock(match);

        let scoreDisplayHTML = `${match.homeScore} - ${match.awayScore}`;
        if (match.stats.type === 'volleyball' && !match.isFinal) {
          scoreDisplayHTML = `<div style="font-size:34px;">${match.homeScore} - ${match.awayScore}</div><div style="font-size:13px; font-family:var(--font-sans); color:rgba(255,255,255,0.7); margin-top:4px;">Set ${match.period}: ${match.stats.scbSetPts}-${match.stats.oppSetPts}</div>`;
        }

        return `
          <div class="hub-match-card" id="card_${match.id}">
            <div class="hub-match-top">
              <span>${match.sport.name.toUpperCase()} · ${match.sport.squad}</span>
              <span class="hub-match-badge ${isLive ? 'live' : 'final'}">
                ${isLive ? '<span class="pulse-dot-live" style="width:6px; height:6px;"></span>' : ''}
                <span id="clock_${match.id}">${displayClock}</span>
              </span>
            </div>
            <div class="hub-match-content">
              <div class="hub-scoreboard">
                <div class="hub-team-block">
                  <div class="hub-team-title">MARLINS</div>
                </div>
                <div class="hub-score-display" id="score_${match.id}">${scoreDisplayHTML}</div>
                <div class="hub-team-block away">
                  <div class="hub-team-title">${match.rival.name.toUpperCase()}</div>
                </div>
              </div>
              <div class="hub-location-row">
                <span style="color:rgba(255,255,255,0.6);">${match.isHome ? 'Home Game' : 'Away Game'}</span>
                <a href="${mapsUrl}" target="_blank" class="hub-map-link">📍 ${match.venue.name}</a>
              </div>
            </div>
            <button type="button" class="hub-stat-accordion-btn" onclick="toggleMatchStatAccordion('${match.id}')">
              <span>Detailed Match Metrics & Team Play-by-Play</span><span>↓</span>
            </button>
            <div class="hub-stat-panel" id="stat_panel_${match.id}">
              <div id="stats_${match.id}">${renderStatPanelHTML(match)}</div>
              <div class="hub-pbp-terminal" id="pbp_${match.id}" style="margin-top:16px;">
                ${match.pbp.map(line => `<div class="hub-pbp-item">> ${line}</div>`).join('')}
              </div>
            </div>
          </div>
        `;
      }).join('') + `</div>`;
    }

    function startLiveSimulator() {
      if (simulationTimer) return;

      simulationTimer = setInterval(() => {
        if (seasonalGamesDatabase.live.length === 0) return;
        let uiNeedsFullTabRender = false;

        for (let i = seasonalGamesDatabase.live.length - 1; i >= 0; i--) {
          const res = processTick(seasonalGamesDatabase.live[i], true);
          if (res.needsTabRender) {
            uiNeedsFullTabRender = true;
            seasonalGamesDatabase.final.unshift(seasonalGamesDatabase.live[i]);
            seasonalGamesDatabase.live.splice(i, 1);
          }
        }

        if (uiNeedsFullTabRender && hubActiveTab === 'live') {
          renderHubCards();
          document.querySelector('.hub-tab-btn[data-tab="live"]').innerHTML = `<span class="pulse-dot-live" style="display:inline-block; width:6px; height:6px; margin-right:6px;"></span> LIVE NOW (${seasonalGamesDatabase.live.length})`;
          document.querySelector('.hub-tab-btn[data-tab="final"]').innerHTML = `RECENT RESULTS (${seasonalGamesDatabase.final.length})`;
        }
      }, 1000);
    }
    renderMegaMenu();
    renderCurrentState();
  </script>
