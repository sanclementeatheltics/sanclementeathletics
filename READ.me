    function escapeHTML(value) {
      return String(value).replace(/[&<>"']/g, character => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      })[character]);
    }

    function describeHonor(honor, captain) {
      const title = honor.toLowerCase();
      const firstName = captain.name.split(' ')[0];
      const topStat = captain.stats && captain.stats[0] ? `${captain.stats[0].value} (${captain.stats[0].label})` : "top-tier season numbers";
      const secondStat = captain.stats && captain.stats[1] ? `${captain.stats[1].value} (${captain.stats[1].label})` : "elite varsity metrics";
      const posText = captain.position ? ` at ${captain.position}` : "";

      let about = "";
      let path = "";

      if (title.includes('cal-hi sports')) {
        about = "Published since 1953, the Cal-Hi Sports All-State selection is the premier statewide high school athletic honor in California, evaluating athletes across all 10 CIF sections to name the absolute best players in the state.";
        path = `${firstName} earned this selection${posText} by posting ${topStat} and ${secondStat}, leading San Clemente Beach against Southern California's toughest Division 1 schedule.`;
      } else if (title.includes('cif state') || title.includes('state')) {
        about = "The CIF State Championship honor is governed by the California Interscholastic Federation and represents the highest competitive podium in California high school sports.";
        path = `${firstName} secured this honor by peaking during the championship postseason series, recording ${topStat} against California's highest-ranked qualifiers.`;
      } else if (title.includes('cif southern section') || title.includes('cif-ss') || title.includes('all-cif') || title.includes('masters')) {
        about = "The CIF Southern Section (CIF-SS) is the largest and most competitive high school athletic section in the United States, comprising over 560 schools.";
        path = `${firstName} earned this recognition${posText} through dominant playoff execution, backing up ${topStat} with ${secondStat} to carry the Marlins deep into the postseason.`;
      } else if (title.includes('orange county') || title.includes('all-county')) {
        about = "The All-Orange County Team is selected annually by regional media and varsity coaches, honoring the top starters across all public and private high schools in Orange County.";
        path = `${firstName} was named All-County after dominating regional matchups all season long, pacing the Marlins with ${topStat} and setting the physical tone${posText}.`;
      } else if (title.includes('most valuable') || title.includes('player of the year') || title.includes('mvp') || title.includes('swimmer of the meet')) {
        about = "The Most Valuable Player / Athlete of the Year award is the highest individual distinction in conference or invitational play, voted on directly by opposing head coaches.";
        path = `Opposing coaches voted ${firstName} the top competitor in the league after ${firstName} recorded ${topStat} and ${secondStat} while taking over every close contest.`;
      } else if (title.includes('all-american') || title.includes('avca') || title.includes('nfhca') || title.includes('usa') || title.includes('nisca')) {
        about = "National All-American honors are awarded by the sport's national governing body and coaching association to recognize top high school upperclassmen across the United States.";
        path = `${firstName} earned national recognition by pairing ${topStat} and ${secondStat} with standout performances against nationally ranked competition.`;
      } else if (title.includes('academic') || title.includes('scholar') || title.includes('honor roll')) {
        about = "Scholar-Athlete and Academic honors are presented to varsity letterwinners who maintain an unweighted 3.5+ or weighted 4.0+ GPA while competing at the varsity level.";
        path = `${firstName} earned this academic distinction by balancing intense training blocks, film study, and leadership duties with top-of-the-class coursework.`;
      } else {
        about = "A premier championship and invitational honor awarded to standout varsity athletes who demonstrate elite technical skill and competitive excellence.";
        path = `${firstName} captured this honor${posText} behind a standout campaign featuring ${topStat} and ${secondStat}, setting the daily standard for the entire roster.`;
      }

      return { about, path };
    }

    function showHonorExplanation(sportId, honorIndex, trigger) {
      const sport = SPORTS_DATA.find(item => item.id === sportId);
      const honor = sport && sport.captain.honors[honorIndex];
      if (!sport || !honor) return;
      closeHonorExplanation(false);
      const explanation = describeHonor(honor, sport.captain);
      const layer = document.createElement('div');
      layer.id = 'honor-explanation-layer';
      layer.className = 'honor-explanation-layer';
      layer.setAttribute('role', 'dialog');
      layer.setAttribute('aria-modal', 'true');
      layer.setAttribute('aria-labelledby', 'honor-explanation-title');
      layer.innerHTML = `
        <article class="honor-explanation-card">
          <button type="button" class="honor-detail-close" aria-label="Close honor explanation" onclick="closeHonorExplanation()">×</button>
          <div class="section-kicker" style="font-size:17px; margin-bottom:5px;">${escapeHTML(sport.captain.name)}</div>
          <h2 id="honor-explanation-title">${escapeHTML(honor)}</h2>
          <h3>About this honor</h3>
          <p>${escapeHTML(explanation.about)}</p>
          <h3>Why ${escapeHTML(sport.captain.name.split(' ')[0])} earned this</h3>
          <p>${escapeHTML(explanation.path)}</p>
          <p style="margin-top:14px; font-size:11px; color:var(--text-muted);">Tap outside or press × to close.</p>
        </article>
      `;
      document.body.appendChild(layer);
      const closeButton = layer.querySelector('.honor-detail-close');
      if (closeButton) closeButton.focus();
      layer._trigger = trigger;
    }

    function closeHonorExplanation(restoreFocus = true) {
      const layer = document.getElementById('honor-explanation-layer');
      if (!layer) return;
      const trigger = layer._trigger;
      layer.remove();
      if (restoreFocus && trigger && document.contains(trigger)) trigger.focus();
    }

