       ========================================= */
    .live-hub-trigger {
      background: var(--red);
      border: 1px solid #ff4d56;
      color: #fff;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 13px;
      letter-spacing: 0.12em;
      padding: 7px 16px;
      border-radius: 4px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .live-hub-trigger:hover {
      background: var(--red-hover);
      transform: translateY(-1px);
      box-shadow: 0 4px 16px rgba(216, 30, 40, 0.45);
    }
    .pulse-dot-live {
      width: 9px;
      height: 9px;
      background-color: var(--powder-blue);
      border-radius: 50%;
      box-shadow: 0 0 0 0 rgba(126, 182, 255, 0.7);
      animation: livePulseGlow 1.4s infinite cubic-bezier(0.4, 0, 0.6, 1);
    }
    @keyframes livePulseGlow {
      0% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(126, 182, 255, 0.8), 0 0 10px var(--powder-blue);
      }
      70% {
        transform: scale(1.1);
        box-shadow: 0 0 0 8px rgba(126, 182, 255, 0), 0 0 16px rgba(126, 182, 255, 0.5);
      }
      100% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(126, 182, 255, 0), 0 0 4px rgba(126, 182, 255, 0.2);
      }
    }
    .live-hub-overlay {
      position: fixed;
      inset: 0;
      background: rgba(7, 23, 43, 0.96);
      z-index: 10001;
      display: none;
      flex-direction: column;
      overflow-y: auto;
      backdrop-filter: blur(12px);
      color: #fff;
    }
    .live-hub-overlay.active { display: flex; }
    .hub-header-bar {
      padding: 24px 36px;
      border-bottom: 1px solid var(--border-dark);
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--navy-dark);
      position: sticky;
      top: 0;
      z-index: 10;
    }
    .hub-header-title h2 {
