    function createPosterSVG(type) {
      if (type === 'waterpolo') {
        return `data:image/svg+xml;utf8,` + encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 440"><rect width="400" height="440" fill="#ffffff"/><path d="M20,160 L150,70 L130,190 L50,240 Z" fill="#102a56" stroke="#d81e28" stroke-width="5"/><path d="M260,80 L380,150 L340,250 L250,190 Z" fill="#102a56" stroke="#d81e28" stroke-width="5"/><text x="200" y="34" text-anchor="middle" font-family="Impact, sans-serif" font-size="26" fill="#d81e28" letter-spacing="2">SAN CLEMENTE BEACH</text><path d="M105,230 Q200,205 295,230 L325,430 L75,430 Z" fill="#e0a387"/><path d="M135,230 L265,230 L255,390 L145,390 Z" fill="#d49377"/><path d="M158,85 Q200,55 242,85 L248,165 L230,175 L225,125 L175,125 L170,175 L152,165 Z" fill="#1b3c73" stroke="#d81e28" stroke-width="3"/><circle cx="158" cy="142" r="12" fill="#d81e28"/><circle cx="242" cy="142" r="12" fill="#d81e28"/><text x="200" y="108" text-anchor="middle" font-family="sans-serif" font-size="18" fill="#ffffff" font-weight="bold">7</text><ellipse cx="200" cy="150" rx="34" ry="42" fill="#e5ab8f"/><path d="M185,142 L194,142 M206,142 L215,142" stroke="#3a2318" stroke-width="3" stroke-linecap="round"/><path d="M190,168 Q200,174 210,168" stroke="#3a2318" stroke-width="2.5" fill="none"/><circle cx="95" cy="375" r="46" fill="#f4c430" stroke="#102a56" stroke-width="3"/><path d="M55,360 Q95,335 135,360 M55,390 Q95,415 135,390" stroke="#d81e28" stroke-width="4" fill="none"/><path d="M0,405 Q100,385 200,405 T400,405 L400,440 L0,440 Z" fill="#1b4d89"/><text x="200" y="382" text-anchor="middle" font-family="Georgia, serif" font-style="italic" font-weight="bold" font-size="22" fill="#d81e28" stroke="#ffffff" stroke-width="1">Team Captain</text><text x="200" y="422" text-anchor="middle" font-family="Georgia, serif" font-style="italic" font-weight="bold" font-size="34" fill="#ffffff" stroke="#102a56" stroke-width="1.5">William Vance</text></svg>`);
