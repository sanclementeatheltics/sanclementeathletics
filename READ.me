      width: 100%;
      margin: 0 auto;
      padding: 36px 32px 64px;
    }
    .hub-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
      gap: 24px;
    }
    .hub-match-card {
