  function generateUniqueRecruitingProfile(athleteName, sportName, grade, height, weight, position) {
    let hash = 0;
    for (let i = 0; i < athleteName.length; i++) hash = (hash << 5) - hash + athleteName.charCodeAt(i);
    const absHash = Math.abs(hash);

    const gpa = (3.2 + (absHash % 13) * 0.1).toFixed(2);
    const street = SOCAL_STREETS[absHash % SOCAL_STREETS.length];
    const major = COLLEGE_MAJORS[absHash % COLLEGE_MAJORS.length];
    
    // Check if this athlete is a team captain with a specific birthplace assigned
    const cleanTarget = String(athleteName).replace(/\s+(Sr\.|Jr\.|So\.|Fr\.)$/i, '').trim().toLowerCase();
    const matchedCapSport = SPORTS_DATA.find(s =>
      String(s.captain.name).replace(/\s+(Sr\.|Jr\.|So\.|Fr\.)$/i, '').trim().toLowerCase() === cleanTarget
    );
    const birthplace = matchedCapSport
      ? matchedCapSport.captain.hometown
      : ATHLETE_BIRTHPLACES[absHash % ATHLETE_BIRTHPLACES.length];

    let sat = "N/A";
    let act = "N/A";
    if (grade === "Sr." || grade === "Jr.") {
      sat = String(1180 + (absHash % 280));
      act = String(24 + (absHash % 12));
    }

    const phone = `(949) ${200 + (absHash % 700)}-${1000 + (absHash % 8999)}`;
    const email = `${athleteName.toLowerCase().replace(/[^a-z]/g, '')}.marlins27@gmail.com`;

    return {
      address: `${street}, San Clemente, CA 92673`,
      birthplace: birthplace,
      gpa: gpa,
      sat: sat,
      act: act,
      major: major,
      phone: phone,
      email: email,
      height: height,
      weight: weight,
      position: position,
      sport: sportName
    };
  }

