          lines: [
            { match: "Singles 1", scbGames: 0, oppGames: 0, status: "Playing" }, { match: "Singles 2", scbGames: 0, oppGames: 0, status: "Playing" },
            { match: "Singles 3", scbGames: 0, oppGames: 0, status: "Playing" }, { match: "Singles 4", scbGames: 0, oppGames: 0, status: "Playing" },
            { match: "Singles 5", scbGames: 0, oppGames: 0, status: "Playing" }, { match: "Singles 6", scbGames: 0, oppGames: 0, status: "Playing" },
            { match: "Doubles 1", scbGames: 0, oppGames: 0, status: "Playing" }, { match: "Doubles 2", scbGames: 0, oppGames: 0, status: "Playing" },
            { match: "Doubles 3", scbGames: 0, oppGames: 0, status: "Playing" }
          ],
          scbWinners: 0, scbErrors: 0, oppWinners: 0, oppErrors: 0
        };
      }
      if (id.includes('volleyball')) return { type: 'volleyball', scbSetPts: 0, oppSetPts: 0, scbKills: 0, scbDigs: 0, scbBlocks: 0, oppKills: 0, oppDigs: 0, oppBlocks: 0 };
      if (id.includes('football')) return { type: 'football', scbYards: 0, scb1stDowns: 0, oppYards: 0, opp1stDowns: 0 };
      if (id.includes('water-polo') || id.includes('soccer') || id.includes('lacrosse') || id.includes('hockey')) {
        return { type: 'goal_sport', scbShots: 0, scbSaves: 0, oppShots: 0, oppSaves: 0 };
      }
      if (id.includes('surfing')) return { type: 'surfing', scbWave: "0.00", oppWave: "0.00" };
      if (id.includes('baseball') || id.includes('softball')) return { type: 'diamond', scbHits: 0, scbErrors: 0, scbK: 0, oppHits: 0, oppErrors: 0, oppK: 0 };
      if (id.includes('wrestling')) return { type: 'wrestling', scbPins: 0, scbTD: 0, oppPins: 0, oppTD: 0 };
      if (id.includes('golf')) return { type: 'golf', scbBirdies: 0, scbPars: 0, oppBirdies: 0, oppPars: 0 };
      if (id.includes('swimming') || id.includes('track')) return { type: 'meet', scbEventsWon: 0, oppEventsWon: 0 };
      if (id.includes('sailing')) return { type: 'sailing', scbAFleet: 0, oppAFleet: 0 };
      if (id.includes('fencing')) return { type: 'fencing', scbTouches: 0, oppTouches: 0 };
      
      return { type: 'basketball', scbReb: 0, scbAst: 0, oppReb: 0, oppAst: 0 };
    }

    function getOrdinal(n) {
      if (n === 1) return 'st'; if (n === 2) return 'nd'; if (n === 3) return 'rd'; return 'th';
    }

    function formatClock(match) {
      if (match.isFinal) return "FINAL";
      if (match.periodName === 'OT') return "OVERTIME";
      if (match.isUntimed) {
        if (match.periodName === 'Inning') return `${match.clock % 2 === 0 ? "Top" : "Bot"} ${match.period}${getOrdinal(match.period)}`;
        return `${match.periodName} ${match.period}`;
      }
      const m = Math.floor(match.clock / 60);
      const s = match.clock % 60;
      return `${match.period}${getOrdinal(match.period)} ${match.periodName} · ${m}:${s.toString().padStart(2, '0')}`;
    }

    function getPeriodLength(m) {
      if (m.periodName === 'Qtr' && m.sport.id.includes('football')) return 720;
      if (m.periodName === 'Qtr') return 480;
      if (m.periodName === 'OT') return 300;
      if (!m.isUntimed) return 2400; // Halves
      return 60; // Untimed logic ticks
    }

    function buildSeasonalDatabase() {
      const activeSeason = getCurrentSchoolSeason();
      const seasonSports = SPORTS_DATA.filter(s => s.season === activeSeason && !s.id.includes('cross-country') && !s.id.includes('cheer'));

      seasonSports.forEach((sp, idx) => {
        const rival = SOUTH_COAST_RIVALS[idx % SOUTH_COAST_RIVALS.length];
        const isHome = idx % 2 === 0;
        
        let pName = 'Half'; let mPeriods = 2; let pLength = 2400; 
        if (sp.id.includes('football') || sp.id.includes('lacrosse')) { pName = 'Qtr'; mPeriods = 4; pLength = 720; }
        else if (sp.id.includes('basketball') || sp.id.includes('water-polo')) { pName = 'Qtr'; mPeriods = 4; pLength = 480; }
        else if (sp.id.includes('volleyball')) { pName = 'Set'; mPeriods = 5; pLength = 0; }
        else if (sp.id.includes('baseball') || sp.id.includes('softball')) { pName = 'Inning'; mPeriods = 7; pLength = 0; }
        else if (sp.id.includes('tennis') || sp.id.includes('badminton')) { pName = 'Match'; mPeriods = 1; pLength = 0; }
        else if (sp.id.includes('wrestling')) { pName = 'Bout'; mPeriods = 14; pLength = 0; }
        else if (sp.id.includes('golf')) { pName = 'Hole'; mPeriods = 9; pLength = 0; }
        else if (sp.id.includes('swimming') || sp.id.includes('track')) { pName = 'Event'; mPeriods = 16; pLength = 0; }
        else if (sp.id.includes('sailing')) { pName = 'Race'; mPeriods = 6; pLength = 0; }
        else if (sp.id.includes('fencing')) { pName = 'Relay Bout'; mPeriods = 9; pLength = 0; }
        else if (sp.id.includes('surfing')) { pName = 'Heat'; mPeriods = 4; pLength = 1200; }

        const matchObj = {
          id: 'gm_' + sp.id, sport: sp, rival: rival, isHome: isHome, venue: isHome ? SCB_HOME_LOCATION : rival,
          period: 1, maxPeriods: mPeriods, periodName: pName, clock: pLength > 0 ? pLength : 60, isUntimed: pLength === 0,
          homeScore: 0, awayScore: 0, isFinal: false, stats: createSpecificMatchStats(sp.id),
          pbp: ["Teams taking the field. Anticipation building..."]
        };

        if (Math.random() > 0.3) {
          seasonalGamesDatabase.live.push(matchObj);
        } else {
          const gameDate = new Date(); gameDate.setDate(gameDate.getDate() + Math.floor(Math.random()*5)+1);
          matchObj.dateStr = gameDate.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
          matchObj.timeStr = isHome ? "7:00 PM" : "3:15 PM";
          seasonalGamesDatabase.upcoming.push(matchObj);
        }
      });
    }

    function fastForwardMatch(m, ticks) {
      for (let i = 0; i < ticks; i++) {
        processTick(m, false);
        if (m.isFinal) break;
      }
    }

    function processTick(m, updateDOM = true) {
      let clockTicked = false;
      let isScoringEvent = false;

      // 1. Process Clock
      m.clock -= 1;
      clockTicked = true;
      if (m.clock <= 0) {
        if (m.period >= m.maxPeriods) {
          // STRICT NO-TIE LOGIC (EXCEPT SOCCER)
          if (m.homeScore === m.awayScore && !m.sport.id.includes('soccer') && m.stats.type !== 'racquet' && m.stats.type !== 'volleyball') {
            m.maxPeriods++; 
            m.period++;
            m.periodName = 'OT';
            m.clock = getPeriodLength(m);
            m.pbp.unshift("MATCH TIED AT THE HORN! Heading to Overtime.");
          } else {
             // Resolve Low-Score Wins (Golf) or Tie-Breakers
             if (m.homeScore === m.awayScore && !m.sport.id.includes('soccer')) {
                 if(m.stats.type === 'golf' || m.stats.type === 'sailing') m.homeScore--;
                 else m.homeScore++;
             }
             m.isFinal = true; m.clock = 0;
             m.pbp.unshift("MATCH FINALIZED UNDER CIF PROTOCOL.");
             return { needsTabRender: true };
          }
        } else {
          m.period++;
          m.clock = getPeriodLength(m);
          const startName = m.periodName === 'Inning' ? (m.clock % 2 === 0 ? "Top" : "Bottom") : m.periodName;
          m.pbp.unshift(`--- Start of ${m.period}${getOrdinal(m.period)} ${startName} ---`);
        }
      }

      // 2. Realistic Scoring Logic
      const isSCB = Math.random() > 0.45; 
      const oppName = m.rival.name;
      const type = m.stats.type;

      if (type === 'racquet') {
        if (Math.random() < 0.08) { 
          isScoringEvent = true;
          const active = m.stats.lines.filter(l => l.status === "Playing");
          if (active.length > 0) {
            const l = active[Math.floor(Math.random() * active.length)];
            if (isSCB) {
              l.scbGames++; m.stats.scbWinners++; m.pbp.unshift(`Marlins secure a game on ${l.match}.`);
              if (l.scbGames >= 6 && l.scbGames - l.oppGames >= 2) { l.status = 'Final'; m.homeScore++; m.pbp.unshift(`Marlins WIN ${l.match}.`); }
            } else {
              l.oppGames++; m.stats.oppWinners++; m.pbp.unshift(`${oppName} holds serve on ${l.match}.`);
              if (l.oppGames >= 6 && l.oppGames - l.scbGames >= 2) { l.status = 'Final'; m.awayScore++; m.pbp.unshift(`${oppName} wins ${l.match}.`); }
            }
            if (m.stats.lines.every(ln => ln.status === "Final")) {
              m.isFinal = true; m.pbp.unshift("ALL 9 LINES COMPLETED. MATCH FINALIZED.");
              return { needsTabRender: true };
            }
          }
        }
      } else if (type === 'volleyball') {
        if (Math.random() < 0.12) { 
          isScoringEvent = true;
          const playTo = m.period === 5 ? 15 : 25;
          if (isSCB) { m.stats.scbSetPts++; m.stats.scbKills++; m.pbp.unshift(`Marlins secure the point with a cross-court kill.`); }
          else { m.stats.oppSetPts++; m.stats.oppKills++; m.pbp.unshift(`${oppName} finds the floor past the block.`); }
          
          if (m.stats.scbSetPts >= playTo && m.stats.scbSetPts - m.stats.oppSetPts >= 2) { 
            m.homeScore++; m.stats.scbSetPts = 0; m.stats.oppSetPts = 0; m.period++; m.pbp.unshift(`SCB takes the set!`);
          } else if (m.stats.oppSetPts >= playTo && m.stats.oppSetPts - m.stats.scbSetPts >= 2) { 
            m.awayScore++; m.stats.scbSetPts = 0; m.stats.oppSetPts = 0; m.period++; m.pbp.unshift(`${oppName} takes the set.`);
          }
          if (m.homeScore === 3 || m.awayScore === 3) {
            m.isFinal = true; m.pbp.unshift("MATCH POINT CONVERTED. MATCH FINALIZED.");
            return { needsTabRender: true };
          }
        }
      } else if (type === 'football') {
        if (Math.random() < 0.005) { 
          isScoringEvent = true;
          const pts = Math.random() > 0.3 ? 7 : 3;
          if (isSCB) {
            m.homeScore += pts; m.stats.scbYards += Math.floor(Math.random()*40)+15; m.stats.scb1stDowns++;
            m.pbp.unshift(pts===7 ? `TOUCHDOWN MARLINS! The offensive line paves the way.` : `Marlins field goal unit converts.`);
          } else {
            m.awayScore += pts; m.stats.oppYards += 35; m.stats.opp1stDowns++;
            m.pbp.unshift(`${oppName} answers with ${pts} points on a methodical drive.`);
          }
        } else if (Math.random() < 0.03) { if (isSCB) m.stats.scbYards += 5; else m.stats.oppYards += 5; }
      } else if (type === 'basketball') {
        if (Math.random() < 0.025) { 
          isScoringEvent = true;
          const pts = Math.random() > 0.6 ? 3 : 2;
          if (isSCB) { m.homeScore += pts; m.stats.scbAst++; m.pbp.unshift(`SCB executes the half-court set perfectly for a bucket.`); }
          else { m.awayScore += pts; m.stats.oppAst++; m.pbp.unshift(`${oppName} converts in transition.`); }
        }
      } else if (type === 'goal_sport') {
        if (Math.random() < 0.002) { 
          isScoringEvent = true;
          if (isSCB) { m.homeScore++; m.stats.scbShots++; m.pbp.unshift(`GOAL MARLINS! SCB forces a turnover and finishes on the break.`); }
          else { m.awayScore++; m.stats.oppShots++; m.pbp.unshift(`${oppName} breaks through the defensive line to score.`); }
        } else if (Math.random() < 0.01) { if (isSCB) m.stats.scbShots++; else m.stats.oppShots++; }
      } else if (type === 'diamond') {
        if (Math.random() < 0.012) { 
          isScoringEvent = true;
          if (isSCB) { m.homeScore++; m.stats.scbHits++; m.pbp.unshift(`Marlins drive in a run with a clutch hit to the gap.`); }
          else { m.awayScore++; m.stats.oppHits++; m.pbp.unshift(`${oppName} scores on a base hit.`); }
        }
      } else if (type === 'wrestling') {
        if (Math.random() < 0.015) { 
          isScoringEvent = true;
          const pts = [3, 4, 5, 6][Math.floor(Math.random() * 4)];
          if (isSCB) { m.homeScore += pts; m.stats.scbTD++; if (pts===6) m.stats.scbPins++; m.pbp.unshift(`Marlins secure a ${pts}-point bout victory.`); }
          else { m.awayScore += pts; m.stats.oppTD++; if (pts===6) m.stats.oppPins++; m.pbp.unshift(`${oppName} wins the bout and adds ${pts} points.`); }
        }
      } else if (type === 'meet') {
        if (Math.random() < 0.02) { 
          isScoringEvent = true;
          if (isSCB) { m.homeScore += 5; m.stats.scbEventsWon++; m.pbp.unshift(`Marlins sweep the top podium spot in the current event.`); }
          else { m.awayScore += 5; m.stats.oppEventsWon++; m.pbp.unshift(`${oppName} takes first place in the heat.`); }
        }
      } else if (type === 'golf') {
        if (Math.random() < 0.04) { 
          isScoringEvent = true;
          const strokes = Math.floor(Math.random() * 3) + 3;
          if (isSCB) { m.homeScore += strokes; m.stats.scbPars++; m.pbp.unshift(`Marlins sink a solid putt to close out the hole.`); }
          else { m.awayScore += strokes; m.stats.oppPars++; m.pbp.unshift(`${oppName} records a par.`); }
        }
      }

      if (isScoringEvent && m.pbp.length > 8) m.pbp.pop();

      // 3. Update DOM dynamically without flickering
      if (updateDOM && hubActiveTab === 'live') {
        const clockEl = document.getElementById('clock_' + m.id);
        if (clockEl && clockTicked) clockEl.innerText = formatClock(m);

        if (isScoringEvent || (type === 'volleyball' && clockTicked)) {
          const scoreEl = document.getElementById('score_' + m.id);
          const pbpEl = document.getElementById('pbp_' + m.id);
          const statsEl = document.getElementById('stats_' + m.id);
          
          if (scoreEl) {
            if (type === 'volleyball') {
              scoreEl.innerHTML = `<div style="font-size:34px;">${m.homeScore} - ${m.awayScore}</div><div style="font-size:14px; font-family:var(--font-sans); color:rgba(255,255,255,0.7); margin-top:2px;">Set ${m.period}: ${m.stats.scbSetPts}-${m.stats.oppSetPts}</div>`;
            } else {
              scoreEl.innerText = `${m.homeScore} - ${m.awayScore}`;
            }
          }
          if (pbpEl) pbpEl.innerHTML = m.pbp.map(line => `<div class="hub-pbp-item">> ${line}</div>`).join('');
          if (statsEl) statsEl.innerHTML = renderStatPanelHTML(m);
        }
      }
      return { needsTabRender: false };
    }

    function openLiveHub() {
      if (seasonalGamesDatabase.live.length === 0 && seasonalGamesDatabase.upcoming.length === 0 && seasonalGamesDatabase.final.length === 0) {
        buildSeasonalDatabase();
        // Fast-Forward all live games organically
        seasonalGamesDatabase.live.forEach(m => fastForwardMatch(m, Math.floor(Math.random() * 1800) + 600));
        // Filter out any that went final during fast-forward
        const finished = seasonalGamesDatabase.live.filter(m => m.isFinal);
        seasonalGamesDatabase.final.push(...finished);
        seasonalGamesDatabase.live = seasonalGamesDatabase.live.filter(m => !m.isFinal);
      }

      let overlay = document.getElementById('live-hub-overlay');
      if (!overlay) {
        overlay = document.createElement('div');
        overlay.id = 'live-hub-overlay';
        overlay.className = 'live-hub-overlay active';
        document.body.appendChild(overlay);
      } else {
        overlay.classList.add('active');
      }

      renderLiveHubStructure();
      startLiveSimulator();
    }

    function closeLiveHub() {
      const overlay = document.getElementById('live-hub-overlay');
      if (overlay) overlay.classList.remove('active');
    }

    function switchHubTab(tabName) {
      hubActiveTab = tabName;
      document.querySelectorAll('.hub-tab-btn').forEach(btn => btn.classList.toggle('active', btn.dataset.tab === tabName));
      renderHubCards();
    }

    function toggleMatchStatAccordion(cardId) {
      const panel = document.getElementById('stat_panel_' + cardId);
      if (panel) panel.classList.toggle('open');
    }

    function renderLiveHubStructure() {
      const overlay = document.getElementById('live-hub-overlay');
      const activeSeason = getCurrentSchoolSeason();
      const dayNames = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
      const currentDay = dayNames[new Date().getDay()];

      overlay.innerHTML = `
        <header class="hub-header-bar">
          <div class="hub-header-title">
            <span>CIF Southern Section · ${currentDay} Real-Time Slate</span>
            <h2>MARLINS ACTION HUB</h2>
          </div>
          <button type="button" class="hub-close-btn" onclick="closeLiveHub()" aria-label="Close Live Hub">×</button>
        </header>

        <nav class="hub-nav-tabs">
          <button type="button" class="hub-tab-btn ${hubActiveTab === 'live' ? 'active' : ''}" data-tab="live" onclick="switchHubTab('live')">
            <span class="pulse-dot-live" style="display:inline-block; width:6px; height:6px; margin-right:6px;"></span>
            LIVE NOW (${seasonalGamesDatabase.live.length})
          </button>
          <button type="button" class="hub-tab-btn ${hubActiveTab === 'final' ? 'active' : ''}" data-tab="final" onclick="switchHubTab('final')">
            RECENT RESULTS (${seasonalGamesDatabase.final.length})
          </button>
          <button type="button" class="hub-tab-btn ${hubActiveTab === 'upcoming' ? 'active' : ''}" data-tab="upcoming" onclick="switchHubTab('upcoming')">
            UPCOMING SCHEDULE
          </button>
        </nav>
        <main class="hub-body-container" id="hub-cards-target"></main>
      `;
      renderHubCards();
    }

    function renderStatPanelHTML(match) {
      const s = match.stats;

      if (s.type === 'racquet') {
        const linesHTML = s.lines.map(l => `
          <div class="hub-stat-row" style="border-bottom:1px solid rgba(255,255,255,0.05); padding:6px 0;">
            <span style="color:var(--powder-blue);">${l.match}</span>
            <div style="display:flex; gap:16px;">
              <span>SCB: <strong>${l.scbGames}</strong></span>
              <span>OPP: <strong>${l.oppGames}</strong></span>
              <span style="font-size:10px; opacity:0.6;">(${l.status})</span>
            </div>
          </div>
        `).join('');
        return `
          <div class="section-kicker" style="font-size:10px; margin-bottom:8px;">9-LINE MATCH TRACKER (FIRST TO 5 WINS)</div>
          ${linesHTML}
          <div class="hub-stat-grid" style="margin-top:12px;">
            <div class="hub-stat-box">
              <h6>SCB TEAM METRICS</h6>
              <div class="hub-stat-row"><span>Winners:</span><strong>${s.scbWinners}</strong></div>
              <div class="hub-stat-row"><span>Unforced Errors:</span><strong>${s.scbErrors}</strong></div>
            </div>
