  })();
 /* ============================================================================
     SITE-WIDE VINTAGE CURSIVE GRADE LEVEL FORMATTER
     Automatically separates "Sr.", "Jr.", "So.", "Fr." from athlete names across
     Captain Cards, Portfolios, Sport Spotlights, Modals, and Beyond the Sea
     ============================================================================ */
  function formatNameWithVintageGrade(rawText, fallbackGrade = "") {
    if (!rawText) return "";
    const str = String(rawText).trim();

    // Match trailing Sr., Jr., So., Fr. (case-insensitive, even if .toUpperCase() was used)
    const match = str.match(/^(.*?)\s+(SR\.|JR\.|SO\.|FR\.|Sr\.|Jr\.|So\.|Fr\.)$/);
    if (match) {
      const cleanName = match[1].trim();
      const rawSuffix = match[2].toLowerCase();
      const formattedGrade = rawSuffix.charAt(0).toUpperCase() + rawSuffix.slice(1); // "Sr." or "Jr."
      return `${cleanName} <span class="vintage-grade-tag">${formattedGrade}</span>`;
    }

    if (fallbackGrade) {
      return `${str} <span class="vintage-grade-tag">${fallbackGrade}</span>`;
    }
    return str;
  }

  function applyVintageGradeTagsToContainer(rootEl) {
    if (!rootEl) return;

    // 1. All headings, captain links, commit names, and kickers that contain a trailing Sr./Jr.
    const nameSelectors = [
      '.captain-name-link',
      '.subpage-title',
      '.section-heading',
      '.editorial-athlete-name',
      '.captain-portrait-commit-statement',
      '.honor-explanation-card .section-kicker',
      '.honor-explanation-card h2',
      '.report-commit-box div'
    ];

   rootEl.querySelectorAll(nameSelectors.join(',')).forEach(el => {
      if (el.querySelector('.vintage-grade-tag')) return;

      // Collapse any newlines/indentations into single spaces and trim before matching
      const normalizedText = el.textContent.replace(/\s+/g, ' ').trim();

      // 1. Special handling for "NAME Sr./Jr. committed to UNIVERSITY" statements
      const committedMatch = normalizedText.match(/^(.*?)\s+(Sr\.|Jr\.|So\.|Fr\.)\s+(committed to\s+.*)$/i);
      if (committedMatch) {
        const cleanName = committedMatch[1].trim();
        const rawSuffix = committedMatch[2].toLowerCase();
        const formattedGrade = rawSuffix.charAt(0).toUpperCase() + rawSuffix.slice(1); // Always "Sr.", "Jr.", "So.", or "Fr."
        const restOfText = committedMatch[3].trim();
        el.innerHTML = `${escapeHTML(cleanName)} <span class="vintage-grade-tag">${formattedGrade}</span> ${escapeHTML(restOfText)}`;
        return;
      }

      // 2. Standard trailing grade suffix (e.g., "EMILY RHODES SR." or "Alex Lukashenko Jr.")
      if (/\s+(SR\.|JR\.|SO\.|FR\.)$/i.test(normalizedText)) {
        el.innerHTML = formatNameWithVintageGrade(escapeHTML(normalizedText));
      }
    }); 

    // 2. Roster Drawer Rows & Non-Captain Commit Cards (where grade is stored separately)
    rootEl.querySelectorAll('.athlete-row').forEach(row => {
      const nameEl = row.querySelector('.athlete-name');
      const metaEl = row.querySelector('.athlete-meta');
      if (!nameEl || !metaEl || nameEl.querySelector('.vintage-grade-tag')) return;

      const metaParts = metaEl.textContent.split('•').map(s => s.trim());
      if (metaParts.length > 1 && /^(Sr\.|Jr\.|So\.|Fr\.)$/i.test(metaParts[0])) {
        const grade = metaParts.shift();
        metaEl.textContent = metaParts.join(' • ');

        // Insert vintage grade tag right after the athlete's name text (before any commit pill)
        const firstTextNode = Array.from(nameEl.childNodes).find(n => n.nodeType === Node.TEXT_NODE && n.textContent.trim());
        if (firstTextNode) {
          const cleanName = firstTextNode.textContent.trim();
          const span = document.createElement('span');
          span.className = 'vintage-grade-tag';
          span.textContent = grade;
          firstTextNode.textContent = cleanName + ' ';
          nameEl.insertBefore(span, firstTextNode.nextSibling);
        }
      }
    });
  }

