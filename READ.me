  function getCommitsDatabase() {
    try {
      const saved = localStorage.getItem('scb_marlins_commits_v2');
      if (saved) return { ...DEFAULT_COMMITMENTS, ...JSON.parse(saved) };
    } catch (e) {}
    return { ...DEFAULT_COMMITMENTS };
  }

  function saveCustomCommit(athleteKey, commitObj) {
    try {
      const existing = JSON.parse(localStorage.getItem('scb_marlins_commits_v2') || '{}');
      existing[athleteKey] = commitObj;
      localStorage.setItem('scb_marlins_commits_v2', JSON.stringify(existing));
    } catch (e) {}
  }

  function findCommitmentForAthlete(name) {
    const db = getCommitsDatabase();
    if (db[name]) return db[name];
    const clean = String(name).replace(/\s+(Sr\.|Jr\.|So\.|Fr\.)$/i, '').trim();
    if (db[clean]) return db[clean];
    if (db[clean + " Sr."]) return db[clean + " Sr."];
    if (db[clean + " Jr."]) return db[clean + " Jr."];
    return null;
  }

