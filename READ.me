      "football", "womens-volleyball", "mens-water-polo", "womens-soccer", "mens-basketball", "womens-surfing", "mens-baseball", "womens-lacrosse", "mens-track-field", "womens-golf", "sailing", "womens-cross-country", "mens-cross-country", "womens-field-hockey", "womens-tennis", "womens-basketball", "cheer", "womens-fencing", "mens-fencing", "mens-soccer", "womens-water-polo", "wrestling", "badminton", "mens-golf", "mens-lacrosse", "womens-softball", "mens-surfing", "womens-swimming-diving", "mens-swimming-diving", "mens-tennis", "womens-track-field", "mens-volleyball"
    ];

    function getGenderClass(squad, prefix = 'sport') {
      if (squad === "WOMEN'S") return `womens-${prefix}`;
      if (squad === "MEN'S") return `mens-${prefix}`;
      return `coed-${prefix}`;
    }

    let currentUploadKey = null;
    function getStoredPhoto(key, fallbackUrl = null) {
      try {
        const saved = localStorage.getItem('scb_photo_' + key);
        if (saved) return saved;
      } catch (e) {}
      return fallbackUrl;
    }

    function triggerPhotoUpload(event, storageKey) {
      event.stopPropagation();
      currentUploadKey = storageKey;
      const fileInput = document.getElementById('global-photo-input');
      fileInput.value = '';
      fileInput.click();
    }

    document.getElementById('global-photo-input').addEventListener('change', function(e) {
      const file = e.target.files && e.target.files[0];
      if (!file || !currentUploadKey) return;
      const reader = new FileReader();
      reader.onload = function(evt) {
        try {
          localStorage.setItem('scb_photo_' + currentUploadKey, evt.target.result);
        } catch (err) {
          window._sessionPhotos = window._sessionPhotos || {};
          window._sessionPhotos[currentUploadKey] = evt.target.result;
        }
        renderCurrentState();
      };
      reader.readAsDataURL(file);
    });

    function resolvePhoto(key, fallback = null) {
      if (window._sessionPhotos && window._sessionPhotos[key]) {
        return window._sessionPhotos[key];
      }
      return getStoredPhoto(key, fallback);
    }

    function cameraPlaceholderHTML(label = "") {
      return `
        <div class="placeholder-graphic">
          <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          ${label ? `<div class="slot-label">${label}</div>` : ''}
        </div>
      `;
    }

    let marlinTimer = null;
    function playMarlinSwimAnimation() {
      const overlay = document.getElementById('marlin-swim-overlay');
      if (!overlay) return;
      if (marlinTimer) clearTimeout(marlinTimer);
      overlay.classList.remove('active');
      overlay.innerHTML = `
        <div class="marlin-swim-backdrop"></div>
        <div class="marlin-swimmer-wrap">
          ${getFullMarlinMascotSVG()}
        </div>
      `;
      void overlay.offsetWidth;
      overlay.classList.add('active');
      marlinTimer = setTimeout(() => {
        overlay.classList.remove('active');
        overlay.innerHTML = '';
      }, 1300);
    }

    let appState = {
      view: 'home',
      sportId: null,
      openSeasons: { FALL: true, WINTER: false, SPRING: false },
      captainSearchQuery: ''
    };

    function renderMegaMenu() {
      const seasons = [
        { key: 'FALL', months: 'AUGUST TO NOVEMBER' },
        { key: 'WINTER', months: 'NOVEMBER TO FEBRUARY' },
        { key: 'SPRING', months: 'FEBRUARY TO MAY' }
      ];
      const container = document.getElementById('mega-grid-content');
      container.innerHTML = seasons.map(sec => {
        const seasonSports = SPORTS_DATA.filter(s => s.season === sec.key);
        const womens = seasonSports.filter(s => s.squad === "WOMEN'S");
        const mens = seasonSports.filter(s => s.squad === "MEN'S");
        const coed = seasonSports.filter(s => s.squad === "CO-ED");
        return `
          <div>
            <div class="mega-season-header">
              <h3>${sec.key}</h3>
              <span>${sec.months}</span>
            </div>
            ${womens.length ? `
              <div class="mega-sub-group">
                <div class="mega-sub-title" style="color:var(--powder-blue);">WOMEN'S SQUADS</div>
                <ul class="mega-sport-list">
                  ${womens.map(s => `<li class="mega-sport-item"><a class="mega-sport-link womens-link" onclick="openSportPage('${s.id}')">${s.name}</a></li>`).join('')}
                </ul>
              </div>
            ` : ''}
            ${mens.length ? `
              <div class="mega-sub-group">
                <div class="mega-sub-title" style="color:#ff7b82;">MEN'S SQUADS</div>
                <ul class="mega-sport-list">
                  ${mens.map(s => `<li class="mega-sport-item"><a class="mega-sport-link mens-link" onclick="openSportPage('${s.id}')">${s.name}</a></li>`).join('')}
                </ul>
              </div>
            ` : ''}
            ${coed.length ? `
              <div class="mega-sub-group">
                <div class="mega-sub-title">CO-ED SQUADS</div>
                <ul class="mega-sport-list">
                  ${coed.map(s => `<li class="mega-sport-item"><a class="mega-sport-link coed-link" onclick="openSportPage('${s.id}')">${s.name}</a></li>`).join('')}
                </ul>
              </div>
            ` : ''}
          </div>
        `;
      }).join('');
    }

    function toggleMegaMenu(e) {
      e.stopPropagation();
      const menu = document.getElementById('mega-menu');
      const btn = document.getElementById('teams-menu-btn');
      const isOpen = menu.classList.toggle('open');
      btn.classList.toggle('active', isOpen);
    }

    function closeMegaMenu() {
      const menu = document.getElementById('mega-menu');
      const btn = document.getElementById('teams-menu-btn');
      if (menu) menu.classList.remove('open');
      if (btn) btn.classList.remove('active');
    }

    document.addEventListener('click', function(e) {
      const honorButton = e.target.closest && e.target.closest('.honor-trigger');
      if (honorButton) {
        e.preventDefault();
        showHonorExplanation(honorButton.dataset.sportId, Number(honorButton.dataset.honorIndex), honorButton);
        return;
      }
      const openExplanation = document.getElementById('honor-explanation-layer');
      if (openExplanation && !e.target.closest('.honor-explanation-card')) {
        closeHonorExplanation();
        return;
      }
      const openAthleteModal = document.getElementById('athlete-modal-layer');
      if (openAthleteModal && !e.target.closest('.honor-explanation-card') && !e.target.closest('.stat-btn')) {
        openAthleteModal.remove();
        return;
      }
      const menu = document.getElementById('mega-menu');
      const searchWrap = document.querySelector('.captain-search-wrapper');
      if (menu && menu.classList.contains('open') && !menu.contains(e.target)) {
        closeMegaMenu();
      }
      const dropdown = document.getElementById('search-suggestions-box');
      if (dropdown && searchWrap && !searchWrap.contains(e.target)) {
        dropdown.classList.remove('open');
      }
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        if (document.getElementById('honor-explanation-layer')) closeHonorExplanation();
        const athleteModal = document.getElementById('athlete-modal-layer');
        if (athleteModal) athleteModal.remove();
      }
    });

    function navigateHome() {
      closeMegaMenu();
      appState.view = 'home';
      appState.sportId = null;
      renderCurrentState();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function openSportPage(sportId) {
      closeMegaMenu();
      appState.view = 'sport';
      appState.sportId = sportId;
      renderCurrentState();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function openCaptainPage(sportId) {
      closeMegaMenu();
      playMarlinSwimAnimation();
      appState.view = 'captain';
      appState.sportId = sportId;
      renderCurrentState();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function scrollToSection(sectionId) {
      closeMegaMenu();
      if (appState.view !== 'home') {
        appState.view = 'home';
        renderCurrentState();
        setTimeout(() => {
          const el = document.getElementById(sectionId);
          if (el) el.scrollIntoView({ behavior: 'smooth' });
        }, 60);
      } else {
        const el = document.getElementById(sectionId);
        if (el) el.scrollIntoView({ behavior: 'smooth' });
      }
    }

    function toggleSeasonAccordion(seasonKey) {
      appState.openSeasons[seasonKey] = !appState.openSeasons[seasonKey];
      const itemEl = document.getElementById('acc-item-' + seasonKey);
      if (itemEl) {
        itemEl.classList.toggle('open', appState.openSeasons[seasonKey]);
      } else {
        renderCurrentState();
      }
    }

    function handleCaptainSearchInput(val) {
      appState.captainSearchQuery = val;
      const dropdown = document.getElementById('search-suggestions-box');
      const gridContainer = document.getElementById('dynamic-captains-grid');
      if (!gridContainer) return;
      gridContainer.innerHTML = buildCaptainsGridHTML(val);
      if (!dropdown) return;
      const q = val.toLowerCase().trim();
      if (!q) {
        dropdown.classList.remove('open');
        dropdown.innerHTML = '';
        return;
      }
      const matchedSports = [];
      SPORTS_DATA.forEach(sp => {
        const sportTitle = sp.name.toLowerCase();
        const shortName = sp.shortSport.toLowerCase();
        if (sportTitle.includes(q) || shortName.includes(q) || sp.captain.name.toLowerCase().includes(q)) {
          if (!matchedSports.includes(sp.shortSport)) {
            matchedSports.push(sp.shortSport);
          }
        }
      });
      if (matchedSports.length > 0) {
        dropdown.innerHTML = matchedSports.map(sport => `
          <div class="suggestion-item" onclick="selectSearchSuggestion('${sport}')">
            <span>${sport}</span>
            <span class="match-tag">Match</span>
          </div>
        `).join('');
        dropdown.classList.add('open');
      } else {
        dropdown.classList.remove('open');
        dropdown.innerHTML = '';
      }
    }

    function selectSearchSuggestion(sportName) {
      appState.captainSearchQuery = sportName;
      const input = document.getElementById('captain-search-bar');
      if (input) input.value = sportName;
      const dropdown = document.getElementById('search-suggestions-box');
      if (dropdown) dropdown.classList.remove('open');
      const gridContainer = document.getElementById('dynamic-captains-grid');
      if (gridContainer) {
        gridContainer.innerHTML = buildCaptainsGridHTML(sportName);
      }
    }

    function buildCaptainsGridHTML(query = '') {
      const q = query.toLowerCase().trim();
      const matchedSportIds = [];
      SPORTS_DATA.forEach(sp => {
        if (!q) {
          if (CAPTAIN_GRID_ORDER.includes(sp.id) && !matchedSportIds.includes(sp.id)) {
            matchedSportIds.push(sp.id);
          }
        } else {
          const matchName = sp.name.toLowerCase().includes(q);
          const matchShort = sp.shortSport.toLowerCase().includes(q);
          const matchCap = sp.captain.name.toLowerCase().includes(q);
          if (matchName || matchShort || matchCap) {
            if (matchShort && !matchName && !matchCap) {
              SPORTS_DATA.forEach(other => {
                if (other.shortSport.toLowerCase() === sp.shortSport.toLowerCase() && !matchedSportIds.includes(other.id)) {
                  matchedSportIds.push(other.id);
                }
              });
            } else {
              if (!matchedSportIds.includes(sp.id)) {
                matchedSportIds.push(sp.id);
              }
            }
          }
        }
      });
      if (matchedSportIds.length === 0) {
        return `<div style="grid-column: 1 / -1; text-align: center; padding: 48px; color: rgba(255,255,255,0.6); font-family: var(--font-display); font-size: 22px; letter-spacing: 0.05em;">NO CAPTAINS FOUND MATCHING "${query.toUpperCase()}"</div>`;
      }
      return matchedSportIds.map(id => {
        const sp = SPORTS_DATA.find(item => item.id === id);
        if (!sp) return '';
        const photoUrl = resolvePhoto('captain_' + sp.id, sp.captain.defaultImg);
        const linkGenderClass = getGenderClass(sp.squad, 'link');
        return `
          <div class="captain-card">
            <div class="portrait-box" onclick="openCaptainPage('${sp.id}')">
              ${!photoUrl ? `
                <button type="button" class="upload-trigger" onclick="triggerPhotoUpload(event, 'captain_${sp.id}')">
                  + Upload Photo
                </button>
              ` : ''}
              ${photoUrl
                ? `<img src="${photoUrl}" alt="${sp.captain.name}" />`
                : cameraPlaceholderHTML()
              }
            </div>
            <div class="captain-card-info">
              <div>
                <div class="captain-name-link" onclick="openCaptainPage('${sp.id}')">
                  ${sp.captain.name}
                </div>
                <br/>
                <div class="captain-sport-link ${linkGenderClass}" onclick="openSportPage('${sp.id}')">
                  <span>${sp.name.toUpperCase()}</span>
                </div>
              </div>
              <div class="captain-QuickMeta">
                ${sp.captain.height} · ${sp.captain.hometown}
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function renderHomeView() {
      const seasonsMeta = [
        { key: 'FALL', months: 'AUGUST TO NOVEMBER', count: '8 TEAMS' },
        { key: 'WINTER', months: 'NOVEMBER TO FEBRUARY', count: '9 TEAMS' },
        { key: 'SPRING', months: 'FEBRUARY TO MAY', count: '15 TEAMS' }
      ];
      const accordionsHTML = seasonsMeta.map(sec => {
        const isOpen = appState.openSeasons[sec.key];
        const seasonSports = SPORTS_DATA.filter(s => s.season === sec.key);
