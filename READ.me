  function handleBuilderSchoolSearch(query) {
    const dropdown = document.getElementById('builder-school-dropdown');
    if (!dropdown) return;
    const q = String(query || '').toLowerCase().trim();

    const matches = NCAA_MASTER_DB.filter(s => {
      if (!q) return true;
      return s.name.toLowerCase().includes(q) ||
             s.mascot.toLowerCase().includes(q) ||
             s.division.toLowerCase() === q;
    }).slice(0, 30);

    if (matches.length === 0 && q) {
      dropdown.innerHTML = `
        <div class="ncaa-school-option" onclick="selectBuilderSchoolByName('${escapeHTML(query.trim().replace(/'/g, "\\'"))}')">
          <span style="font-weight:700; color:var(--text-dark);">${escapeHTML(query.trim())}</span>
          <span class="tag-red">SELECT</span>
        </div>
      `;
      dropdown.classList.add('open');
      return;
    }

    dropdown.innerHTML = matches.map(s => `
      <div class="ncaa-school-option" onclick="selectBuilderSchoolByName('${escapeHTML(s.name.replace(/'/g, "\\'"))}')">
        <div style="display:flex; align-items:center; gap:10px;">
          ${renderUniversityLogoImg(s, s.name)}
          <div>
            <div style="font-weight:700; font-size:13px; color:var(--text-dark);">${escapeHTML(s.name)}</div>
            <div style="font-size:11px; color:var(--text-muted);">${escapeHTML(s.mascot)} · NCAA ${escapeHTML(s.division)}</div>
          </div>
        </div>
      </div>
    `).join('');
    dropdown.classList.add('open');
  }

  function selectBuilderSchoolByName(name) {
    const s = getSchoolObject(name);
    beyondSeaState.selectedSchoolObj = s;
    const input = document.getElementById('builder-school-input');
    if (input) input.value = s.name;
    const dropdown = document.getElementById('builder-school-dropdown');
    if (dropdown) dropdown.classList.remove('open');
