    .hub-match-badge.scheduled { color: rgba(255, 255, 255, 0.5); }
    .hub-match-content { padding: 20px; flex-grow: 1; }
    .hub-scoreboard {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 16px;
