    }
    .hub-location-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 0 0;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      font-size: 11.5px;
    }
    .hub-map-link {
      color: var(--powder-blue);
      text-decoration: none;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: color 0.15s;
    }
    .hub-map-link:hover {
      color: #fff;
      text-decoration: underline;
    }
    .hub-stat-accordion-btn {
      width: 100%;
      background: rgba(126, 182, 255, 0.08);
